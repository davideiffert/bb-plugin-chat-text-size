{
  "name": "bb-plugin-chat-text-size",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Chat Text Size",
    "description": "Make the chat text bigger or smaller without changing the sidebar or the rest of BB. A small A A control in the thread header and Option+Command with = or - change it instantly, and each device keeps its own size.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "happy-dom": "^21.0.3",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "bb plugin build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideiffert/bb-plugin-chat-text-size.git"
  },
  "homepage": "https://github.com/davideiffert/bb-plugin-chat-text-size#readme",
  "description": "Make BB's chat text bigger or smaller without changing the sidebar or menus."
